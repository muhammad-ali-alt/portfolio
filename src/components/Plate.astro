---
// An image "plate". If there is no image yet, it draws an empty
// drawing frame with the entry number, so missing renders look
// intentional instead of broken.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src?: ImageMetadata;
  alt?: string;
  number: string;
  ratio?: string; // CSS aspect ratio, e.g. "4 / 3"
  sizes?: string;
  eager?: boolean;
  caption?: string;
}
const { src, alt = '', number, ratio: r = '4 / 3', sizes = '(max-width: 800px) 100vw, 50vw', eager = false } = Astro.props;
// "auto" keeps the image's own proportions so nothing gets cropped off
const ratio = r === 'auto' ? (src ? `${src.width} / ${src.height}` : '16 / 9') : r;
---
<div class="plate" style={`aspect-ratio: ${ratio}`}>
  {src ? (
    <Image src={src} alt={alt} sizes={sizes} widths={[480, 800, 1200, 1800]} loading={eager ? 'eager' : 'lazy'} />
  ) : (
    <div class="empty" role="img" aria-label={`No image yet for ${number}`}>
      <svg class="cross" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
        <line x1="0" y1="50" x2="100" y2="50" vector-effect="non-scaling-stroke" />
        <line x1="50" y1="0" x2="50" y2="100" vector-effect="non-scaling-stroke" />
      </svg>
      <span class="circle" aria-hidden="true"></span>
      <span class="corner tl mono">{number}</span>
      <span class="corner br mono">Image to come</span>
    </div>
  )}
</div>

<style>
  .plate { position: relative; overflow: hidden; background: var(--paper-2); }
  .plate :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 0.8s var(--ease); }
  .empty { position: absolute; inset: 10px; border: 1px solid var(--rule); }
  .cross { position: absolute; inset: 0; width: 100%; height: 100%; }
  .cross line { stroke: var(--rule); stroke-width: 1; stroke-dasharray: 8 4 2 4; }
  .circle {
    position: absolute; left: 50%; top: 50%; width: 18%; aspect-ratio: 1;
    translate: -50% -50%; border: 1px solid var(--graphite); border-radius: 50%;
  }
  .corner { position: absolute; color: var(--graphite); font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.08em; }
  .tl { top: 8px; left: 10px; }
  .br { bottom: 8px; right: 10px; }
</style>
