---
// Expandable profile card. Click the card and it grows into a full
// profile panel. The "grow" uses the browser's View Transitions, the
// same idea as a shared layout animation, with no animation library.
// Everything is styled from theme tokens, so the Studio controls it.
// Portrait: uploaded in the CMS (About me, Portrait), or src/assets/portrait.jpg as a fallback.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { site, about, experience } from '../lib/data';
import { md } from '../lib/markdown';
import { getProjects } from '../lib/content';

const found = import.meta.glob<{ default: ImageMetadata }>('../assets/portrait.{jpg,jpeg,png,webp}', { eager: true });
const portrait = Object.values(found)[0]?.default;
const current = (await getProjects()).filter((p) => p.data.status === 'In progress' && !p.data.sample);
const subtitle = `${site.role} track · ${site.school}`;
---
<div class="pc">
  <button type="button" class="pc-card" aria-haspopup="dialog" aria-label={`Open profile: ${site.name}`}>
    <span class="pc-media" data-pc="img">
      {about.portrait ? (
        <img src={about.portrait} alt="" />
      ) : portrait ? (
        <Image src={portrait} alt="" widths={[600, 1000]} sizes="(max-width: 700px) 100vw, 480px" />
      ) : (
        <span class="pc-empty mono">MA</span>
      )}
    </span>
    <span class="pc-shade" aria-hidden="true"></span>
    <span class="pc-text">
      <span class="pc-sub mono" data-pc="sub">{subtitle}</span>
      <span class="pc-title" data-pc="title">{site.name}</span>
      <span class="pc-open mono" aria-hidden="true">Open profile ↗</span>
    </span>
  </button>

  <dialog class="pc-dialog" aria-label={`Profile: ${site.name}`}>
    <div class="pc-panel">
      <form method="dialog"><button class="pc-close" aria-label="Close profile">✕</button></form>
      <div class="pc-media pc-media-lg" data-pc="img">
        {about.portrait ? (
          <img src={about.portrait} alt={`Portrait of ${site.name}`} />
        ) : portrait ? (
          <Image src={portrait} alt={`Portrait of ${site.name}`} widths={[800, 1400]} sizes="(max-width: 760px) 100vw, 480px" />
        ) : (
          <span class="pc-empty mono">MA<small>Upload a portrait in the CMS: About me</small></span>
        )}
      </div>
      <div class="pc-body">
        <p class="pc-sub mono" data-pc="sub">{subtitle}</p>
        <h3 class="pc-title pc-title-lg" data-pc="title">{site.name}</h3>
        <div class="pc-content">
          <p class="pc-lead">{about.intro}</p>
          <div>
            <h4 class="label">Background</h4>
            <div class="pc-md" set:html={md(about.story.split(/\n\s*\n/)[0])} />
          </div>
          {current.length > 0 && (
            <div>
              <h4 class="label">On the bench</h4>
              <ul>{current.map((p) => <li><a href={`/work/${p.id}/`}><span class="mono">{p.data.number}</span> {p.data.title}</a></li>)}</ul>
            </div>
          )}
          <div>
            <h4 class="label">Teams</h4>
            <ul>{experience.filter((e) => e.type === 'Team').slice(0, 3).map((x) => <li>{x.org}, {x.role.toLowerCase()}</li>)}</ul>
          </div>
          <div class="pc-actions">
            <a class="pc-btn" href={`mailto:${site.email}`}>Email me</a>
            <a class="pc-link" href="/about/">Full profile →</a>
          </div>
        </div>
      </div>
    </div>
  </dialog>
</div>

<script>
  // Shared element transition: the card's image, subtitle and title morph into
  // the panel's. Falls back to a plain open when motion is off or unsupported.
  for (const root of document.querySelectorAll<HTMLElement>('.pc')) {
    const card = root.querySelector<HTMLElement>('.pc-card')!;
    const dialog = root.querySelector<HTMLDialogElement>('.pc-dialog')!;
    const panel = dialog.querySelector<HTMLElement>('.pc-panel')!;
    const parts = (scope: HTMLElement) => ({
      box: scope === card ? card : panel,
      img: scope.querySelector<HTMLElement>('[data-pc="img"]')!,
      sub: scope.querySelector<HTMLElement>('[data-pc="sub"]')!,
      title: scope.querySelector<HTMLElement>('[data-pc="title"]')!,
    });
    const from = parts(card), to = parts(dialog);
    const name = (p: ReturnType<typeof parts>, on: boolean) => {
      p.box.style.viewTransitionName = on ? 'pc-box' : '';
      p.img.style.viewTransitionName = on ? 'pc-img' : '';
      p.sub.style.viewTransitionName = on ? 'pc-sub' : '';
      p.title.style.viewTransitionName = on ? 'pc-title' : '';
    };
    const animated = () =>
      'startViewTransition' in document &&
      document.documentElement.dataset.motion !== 'off' &&
      !matchMedia('(prefers-reduced-motion: reduce)').matches;

    const swap = (a: typeof from, b: typeof from, change: () => void) => {
      if (!animated()) return change();
      name(a, true);
      const t = (document as any).startViewTransition(() => { name(a, false); name(b, true); change(); });
      t.finished.finally(() => name(b, false));
    };

    card.addEventListener('click', () => swap(from, to, () => dialog.showModal()));
    // Closing (button, Esc or backdrop click) runs the morph in reverse.
    dialog.addEventListener('cancel', (e) => { e.preventDefault(); close(); });
    dialog.querySelector('form')!.addEventListener('submit', (e) => { e.preventDefault(); close(); });
    dialog.addEventListener('click', (e) => { if (e.target === dialog) close(); });
    function close() { swap(to, from, () => dialog.close()); }
  }
</script>

<style>
  .pc-card {
    all: unset; box-sizing: border-box; cursor: pointer; display: block; position: relative;
    width: 100%; height: 17rem; overflow: hidden;
    border: var(--bw) solid var(--rule); border-radius: var(--radius); box-shadow: var(--shadow);
    background: var(--surface);
  }
  .pc-card:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .pc-media { position: absolute; inset: 0; display: block; overflow: hidden; background: var(--surface); }
  .pc-media :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform calc(0.6s * var(--speed)) var(--ease); }
  .pc-card:hover .pc-media :global(img) { transform: scale(calc(1 + 0.05 * var(--hover-k))); }
  .pc-empty {
    position: absolute; inset: 0; display: grid; place-content: center; text-align: center; gap: 8px;
    font-size: 3rem; font-weight: 600; color: var(--graphite);
    background:
      linear-gradient(var(--rule) 1px, transparent 1px) 0 0 / 24px 24px,
      linear-gradient(90deg, var(--rule) 1px, transparent 1px) 0 0 / 24px 24px,
      var(--surface);
  }
  .pc-empty small { font-size: 0.68rem; font-weight: 400; letter-spacing: 0.04em; }
  .pc-shade {
    position: absolute; inset: 0; opacity: 0.85;
    background: linear-gradient(to top, rgb(0 0 0 / 0.78), rgb(0 0 0 / 0.15) 55%, transparent);
    transition: opacity calc(0.3s * var(--speed));
  }
  .pc-card:hover .pc-shade { opacity: 1; }
  .pc-text {
    position: absolute; left: 0; right: 0; bottom: 0; padding: 20px 22px; display: grid; gap: 4px; color: #fff;
    transform: translateY(calc(10px * var(--hover-k))); transition: transform calc(0.3s * var(--speed)) var(--ease);
  }
  .pc-card:hover .pc-text { transform: none; }
  .pc-sub { font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.1em; color: rgb(255 255 255 / 0.82); margin: 0; }
  .pc-title { font-family: var(--f-heading); font-weight: var(--w-heading); font-size: 1.45rem; letter-spacing: var(--track); line-height: 1.1; }
  .pc-open { font-size: 0.68rem; opacity: 0; transition: opacity calc(0.3s * var(--speed)); }
  .pc-card:hover .pc-open, .pc-card:focus-visible .pc-open { opacity: 0.85; }
  @media (hover: none) { .pc-open { opacity: 0.85; } .pc-text { transform: none; } }

  .pc-dialog {
    padding: 16px; border: 0; background: transparent; max-width: none; max-height: none;
    width: 100vw; height: 100vh; color: var(--ink);
  }
  .pc-dialog[open] { display: grid; place-items: center; }
  .pc-dialog::backdrop { background: color-mix(in srgb, var(--paper) 86%, transparent); }
  .pc-panel {
    position: relative; width: min(960px, 100%); height: min(82vh, 640px);
    display: grid; grid-template-columns: 1fr 1fr; overflow: hidden;
    background: var(--paper); border: var(--bw) solid var(--rule); border-radius: var(--radius); box-shadow: var(--shadow);
  }
  .pc-media-lg { position: relative; }
  .pc-panel > form { position: absolute; top: 0; right: 0; z-index: 3; }
  .pc-body { padding: clamp(22px, 3vw, 36px); overflow-y: auto; display: grid; align-content: start; gap: 6px; }
  .pc-body .pc-sub { color: var(--accent-ink); }
  .pc-title-lg { font-size: var(--t-h2); padding-bottom: 14px; margin-bottom: 14px; border-bottom: var(--bw) solid var(--rule); }
  .pc-content { display: grid; gap: 20px; font-size: 1rem; }
  .pc-content p { margin: 0; }
  .pc-content h4 { margin: 0 0 6px; font-family: var(--f-mono); font-size: var(--t-mono); font-weight: 450; }
  .pc-content ul { margin: 0; padding: 0; list-style: none; }
  .pc-content li { padding: 6px 0; border-bottom: var(--bw) solid var(--rule); font-family: var(--f-heading); font-size: 0.98rem; }
  .pc-content li a { text-decoration: none; }
  .pc-lead { font-size: 1.1rem; }
  .pc-actions { display: flex; gap: 18px; align-items: center; flex-wrap: wrap; }
  .pc-btn {
    background-color: var(--accent); background-image: var(--g-button); color: var(--on-accent);
    padding: 10px 18px; border-radius: var(--radius-btn); text-decoration: none; font-family: var(--f-heading); font-weight: 600;
  }
  .pc-btn:hover { color: var(--on-accent); filter: brightness(1.08); }
  .pc-link { font-family: var(--f-mono); font-size: 0.8rem; }
  .pc-close {
    position: absolute; top: 12px; right: 12px; z-index: 2; width: 34px; height: 34px; cursor: pointer;
    display: grid; place-items: center; font-size: 0.9rem;
    background: var(--paper); color: var(--ink); border: var(--bw) solid var(--rule); border-radius: var(--radius-btn);
  }
  .pc-close:hover { border-color: var(--ink); }
  @media (max-width: 760px) {
    .pc-panel { grid-template-columns: 1fr; grid-template-rows: 14rem 1fr; height: min(88vh, 760px); }
  }

  /* timing of the morph follows the Studio's motion settings */
  :global(::view-transition-group(pc-box)), :global(::view-transition-group(pc-img)),
  :global(::view-transition-group(pc-sub)), :global(::view-transition-group(pc-title)) {
    animation-duration: var(--dur); animation-timing-function: var(--ease);
  }
</style>
