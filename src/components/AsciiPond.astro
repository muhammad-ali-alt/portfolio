---
// Animated ASCII mosaic of a photo, drawn behind the home page cover.
// The photo is cut into square tiles; each tile takes the photo's color
// there and a character chosen by brightness. The photo's own background
// (sampled from its edges) is dropped so the subject floats on the page.
// The water moves on its own; the cursor sends ripples through it and
// scrambles nearby characters. Inspired by daoho.dev's koi pond.
// Swap the image in the CMS: Site and About, Home page, Cover image.
// Best results: a PNG with a transparent background around the subject.
interface Props { src: string; alt?: string }
const { src, alt = '' } = Astro.props;
---
<div class="pond" data-src={src} role={alt ? 'img' : undefined} aria-label={alt || undefined} aria-hidden={alt ? undefined : 'true'}>
  <canvas></canvas>
</div>

<script>
  const RAMP = ' .:-/|+xXS%#';
  const SCRAMBLE = 'XS%#/|\\x+';

  for (const pond of document.querySelectorAll<HTMLElement>('.pond')) {
    const canvas = pond.querySelector('canvas')!;
    const ctx = canvas.getContext('2d')!;
    const host = pond.parentElement!;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const still = () => reduced.matches || document.documentElement.dataset.motion === 'off';

    // ── load the photo into a small sampling grid ──
    const img = new Image();
    img.decoding = 'async';
    img.src = pond.dataset.src!;
    let sw = 0, sh = 0, rgb = new Uint8ClampedArray(0), alpha = new Float32Array(0);

    img.onload = () => {
      sh = 260; sw = Math.round((img.naturalWidth / img.naturalHeight) * sh);
      const off = document.createElement('canvas');
      off.width = sw; off.height = sh;
      const o = off.getContext('2d', { willReadFrequently: true })!;
      o.drawImage(img, 0, 0, sw, sh);
      const data = o.getImageData(0, 0, sw, sh).data;
      rgb = data;
      // Background color = median of the border pixels, per channel.
      const border: number[][] = [[], [], []];
      for (let x = 0; x < sw; x++) for (const y of [0, 1, sh - 2, sh - 1]) { const i = (y * sw + x) * 4; for (let c = 0; c < 3; c++) border[c].push(data[i + c]); }
      for (let y = 0; y < sh; y++) for (const x of [0, 1, sw - 2, sw - 1]) { const i = (y * sw + x) * 4; for (let c = 0; c < 3; c++) border[c].push(data[i + c]); }
      const bg = border.map((ch) => ch.sort((a, b) => a - b)[ch.length >> 1]);
      alpha = new Float32Array(sw * sh);
      // A cut out PNG (transparent background) is used as is. Otherwise keep the
      // pixels that differ from the background color and fade the rest out.
      let transparent = false;
      for (let p = 3; p < data.length; p += 4) if (data[p] < 250) { transparent = true; break; }
      for (let p = 0; p < sw * sh; p++) {
        const i = p * 4;
        if (transparent) { alpha[p] = data[i + 3] / 255; continue; }
        const d = Math.hypot(data[i] - bg[0], data[i + 1] - bg[1], data[i + 2] - bg[2]);
        const t = Math.min(1, Math.max(0, (d - 38) / 55));
        alpha[p] = t * t * (3 - 2 * t);
      }
      resize();
      start();
    };

    // ── layout: tile size and where the photo sits in the cover ──
    let W = 0, H = 0, dpr = 1, cell = 10, rect = { x: 0, y: 0, w: 0, h: 0 }, paper = [239, 236, 229];
    function resize() {
      const r = host.getBoundingClientRect();
      dpr = Math.min(2, devicePixelRatio || 1);
      W = r.width; H = r.height;
      canvas.width = Math.round(W * dpr); canvas.height = Math.round(H * dpr);
      canvas.style.width = `${W}px`; canvas.style.height = `${H}px`;
      cell = W < 700 ? 8 : W < 1100 ? 10 : 12;
      if (!sw) return;
      const aspect = sw / sh;
      const narrow = W < 760;
      // Desktop: fill the cover's height on the right. Phones: a smaller mosaic in the
      // top right, behind the name only, so the paragraph below stays readable.
      let h = narrow ? H * 0.34 : H * 0.92;
      let w = h * aspect;
      const maxW = narrow ? W * 0.75 : W * 0.5;
      if (w > maxW) { w = maxW; h = w / aspect; }
      rect = narrow ? { x: W - w - W * 0.02, y: H * 0.06, w, h } : { x: W - w - W * 0.015, y: (H - h) / 2, w, h };
      const m = getComputedStyle(document.documentElement).getPropertyValue('--paper').trim().match(/^#([0-9a-f]{6})$/i);
      if (m) paper = [0, 2, 4].map((k) => parseInt(m[1].slice(k, k + 2), 16));
      pond.classList.toggle('is-narrow', narrow);
    }

    // ── ripples from the cursor (and a few on their own) ──
    type Ripple = { x: number; y: number; t: number };
    const ripples: Ripple[] = [];
    let mouse = { x: -1e4, y: -1e4 }, lastDrop = 0, lastAuto = 0;
    host.addEventListener('pointermove', (e) => {
      const r = host.getBoundingClientRect();
      mouse = { x: e.clientX - r.left, y: e.clientY - r.top };
      const now = performance.now() / 1000;
      if (now - lastDrop > 0.09) { ripples.push({ ...mouse, t: now }); lastDrop = now; if (ripples.length > 10) ripples.shift(); }
    });
    host.addEventListener('pointerleave', () => (mouse = { x: -1e4, y: -1e4 }));

    // ── draw one frame ──
    function draw(t: number) {
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, W, H);
      if (!sw) return;
      ctx.font = `${Math.round(cell * 0.82)}px ${getComputedStyle(document.documentElement).getPropertyValue('--f-mono') || 'monospace'}`;
      ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
      if (t - lastAuto > 2.6 && !still()) { // the water is never fully still
        ripples.push({ x: rect.x + rect.w * (0.25 + Math.random() * 0.5), y: rect.y + rect.h * (0.3 + Math.random() * 0.5), t });
        lastAuto = t; if (ripples.length > 10) ripples.shift();
      }
      const c0 = Math.max(0, Math.floor(rect.x / cell) - 1), c1 = Math.min(Math.ceil(W / cell), Math.ceil((rect.x + rect.w) / cell) + 1);
      const r0 = Math.max(0, Math.floor(rect.y / cell) - 1), r1 = Math.min(Math.ceil(H / cell), Math.ceil((rect.y + rect.h) / cell) + 1);
      for (let row = r0; row < r1; row++) {
        for (let col = c0; col < c1; col++) {
          const x = col * cell, y = row * cell, cx = x + cell / 2, cy = y + cell / 2;
          let u = (cx - rect.x) / rect.w, v = (cy - rect.y) / rect.h;
          // gentle standing waves
          u += Math.sin(v * 13 + t * 1.1) * 0.005 + Math.sin(u * 7 - t * 0.6) * 0.003;
          v += Math.cos(u * 11 + t * 0.9) * 0.004;
          // ripples: a ring that travels outward and fades
          let push = 0;
          for (const rp of ripples) {
            const age = t - rp.t; if (age > 2.4) continue;
            const dx = cx - rp.x, dy = cy - rp.y, d = Math.hypot(dx, dy) || 1;
            const ring = Math.sin(d * 0.075 - age * 7) * Math.exp(-age * 1.4) * Math.exp(-d * 0.008);
            u += (dx / d) * ring * 0.012; v += (dy / d) * ring * 0.012; push += Math.abs(ring);
          }
          if (u < 0 || u >= 1 || v < 0 || v >= 1) continue;
          const p = Math.floor(v * sh) * sw + Math.floor(u * sw);
          // soft oval edge so the mosaic never ends in a hard rectangle
          const ex = (u - 0.5) * 2, ey = (v - 0.5) * 2;
          const edge = Math.min(1, Math.max(0, (1 - (ex * ex * 0.9 + ey * ey * 0.75)) * 2.2));
          const a = alpha[p] * edge;
          if (a < 0.06) continue;
          const i = p * 4;
          let r = rgb[i], g = rgb[i + 1], b = rgb[i + 2];
          // the photo is a faded film scan: add contrast and saturation so it reads on light paper
          const avg = (r + g + b) / 3;
          r = (r - avg) * 1.45 + avg; g = (g - avg) * 1.45 + avg; b = (b - avg) * 1.45 + avg;
          r = (r - 128) * 1.2 + 118; g = (g - 128) * 1.2 + 118; b = (b - 128) * 1.2 + 118;
          r = r < 0 ? 0 : r > 255 ? 255 : r; g = g < 0 ? 0 : g > 255 ? 255 : g; b = b < 0 ? 0 : b > 255 ? 255 : b;
          const lum = (0.2126 * r + 0.7152 * g + 0.0722 * b) / 255;
          const lift = Math.min(0.25, push * 0.25); // ripple crests catch light
          r = r + (255 - r) * lift; g = g + (255 - g) * lift; b = b + (255 - b) * lift;
          ctx.globalAlpha = a;
          ctx.fillStyle = `rgb(${(r * 0.95 + paper[0] * 0.05) | 0},${(g * 0.95 + paper[1] * 0.05) | 0},${(b * 0.95 + paper[2] * 0.05) | 0})`;
          ctx.fillRect(x + 0.6, y + 0.6, cell - 1.2, cell - 1.2);
          const near = Math.hypot(cx - mouse.x, cy - mouse.y) < 46;
          const ch = near ? SCRAMBLE[(Math.random() * SCRAMBLE.length) | 0] : RAMP[Math.min(RAMP.length - 1, Math.floor((1 - lum) * RAMP.length))];
          if (ch !== ' ') {
            const k = lum > 0.45 ? 0.45 : 1.6;
            ctx.fillStyle = `rgb(${Math.min(255, r * k) | 0},${Math.min(255, g * k) | 0},${Math.min(255, b * k) | 0})`;
            ctx.fillText(ch, cx, cy + 0.5);
          }
        }
      }
      ctx.globalAlpha = 1;
    }

    // ── run only while visible, about 30 frames a second ──
    let running = false, visible = true, raf = 0, last = 0;
    function loop(ms: number) {
      if (!running) return;
      raf = requestAnimationFrame(loop);
      if (ms - last < 33) return;
      last = ms;
      draw(ms / 1000);
    }
    function start() {
      cancelAnimationFrame(raf);
      running = visible && !still() && !document.hidden;
      if (running) raf = requestAnimationFrame(loop);
      else draw(1.5); // one still frame
    }
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; start(); }).observe(host);
    document.addEventListener('visibilitychange', start);
    reduced.addEventListener('change', start);
    addEventListener('aw-theme', () => { resize(); start(); });
    new ResizeObserver(() => { resize(); if (!running) draw(1.5); }).observe(host);
  }
</script>

<style>
  .pond { position: absolute; inset: 0; z-index: 0; overflow: hidden; pointer-events: none; }
  .pond canvas { display: block; }
  /* On phones the photo sits behind the text, so keep it lighter */
  .pond.is-narrow { opacity: 0.7; }
</style>
