---
// One page per project, generated automatically from each folder
// in src/content/projects. You never edit this file to add a project.
import { render } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ProjectHero from '../../components/ProjectHero.astro';
import ProjectExplore from '../../components/ProjectExplore.astro';
import CaseStudy from '../../components/CaseStudy.astro';
import { prepare, pageHeadings, plan, VIEWER_LABEL } from '../../lib/viewers';
import Revisions from '../../components/Revisions.astro';
import { getAllProjects, getProjects, getCad, getNotebook, fmtMonth, fmtDay, latestRev, isUpload } from '../../lib/content';
import { md } from '../../lib/markdown';

export async function getStaticPaths() {
  // Archived projects keep their page; "Next entry" only cycles through listed ones.
  const listed = await getProjects();
  return (await getAllProjects()).map((p) => {
    const i = listed.findIndex((x) => x.id === p.id);
    return { params: { slug: p.id }, props: { project: p, next: listed[(i + 1) % listed.length], prev: listed[(i - 1 + listed.length) % listed.length], all: listed } };
  });
}

const { project, next, prev, all } = Astro.props;
const d = project.data;
const { Content, headings } = await render(project);
// Still image shown in the 3D viewer until the model loads
const poster = !d.modelPoster ? undefined : isUpload(d.modelPoster) ? d.modelPoster : (await getImage({ src: d.modelPoster, width: 1400, format: 'webp' })).src;
// How this project is presented (src/lib/viewers.ts) and the data its viewers need
const v = await prepare(project);
// Sections added in the CMS come first, then any write up in the body.
const slugify = (t: string) => t.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const sections = d.sections.map((s) => ({ ...s, slug: `s-${slugify(s.title)}`, html: md(s.body) }));
const toc = [...pageHeadings(d), ...sections.map((s) => ({ slug: s.slug, text: s.title })), ...headings.filter((h) => h.depth === 2)];
const relatedCad = (await getCad()).filter((c) => c.data.project === project.id);
const relatedNotes = (await getNotebook()).filter((n) => n.data.project === project.id);
const edit = `/admin/#/collections/projects/entries/${project.id}/index`;
---
<Base title={d.title} description={d.summary} sheet={`${d.number} · ${d.title}`}>
  <article class="wrap">
    <header class="p-head" data-edit={edit} data-edit-label="Edit project">
      <a class="back label" href="/work/">← Index of work</a>
      {d.archived && <span class="sample-tag">Archived</span>}
      <div class="p-num mono">{d.number}{d.category && <span class="p-cat">{d.category}</span>}{v.hero && v.hero !== 'image' && <span class="p-cat">{VIEWER_LABEL[v.hero]}</span>}{d.sample && <span class="sample-tag">Sample, not real work</span>}</div>
      <h1>{d.title}</h1>
      <p class="p-sum">{d.summary}</p>
    </header>

    <!-- Title block: the facts, laid out like the corner of a drawing -->
    <dl class="tblock">
      <div><dt class="label">Drawing no.</dt><dd class="mono">{d.number}</dd></div>
      <div><dt class="label">Rev</dt><dd class="rev">{latestRev(project)}</dd></div>
      <div><dt class="label">Status</dt><dd class="status mono" data-status={d.status}>{d.status}</dd></div>
      <div><dt class="label">{d.endDate ? 'Dates' : 'Started'}</dt><dd>{fmtMonth(d.date)}{d.endDate && ` to ${fmtMonth(d.endDate)}`}</dd></div>
      <div><dt class="label">Context</dt><dd>{d.context}</dd></div>
      <div class="wide"><dt class="label">Discipline</dt><dd>{d.disciplines.join(', ')}</dd></div>
      <div class="wide"><dt class="label">Tools</dt><dd>{d.tools.join(', ') || '—'}</dd></div>
      {d.materials.length > 0 && <div class="wide"><dt class="label">Materials</dt><dd>{d.materials.join(', ')}</dd></div>}
      {d.collaborators.length > 0 && <div class="wide"><dt class="label">With</dt><dd>{d.collaborators.join(', ')}</dd></div>}
      {d.specs.map((sp) => <div class="wide"><dt class="label">{sp.label}</dt><dd>{sp.value}</dd></div>)}
    </dl>

    <!-- Main view, picked per project (viewer: auto, or set in the CMS) -->
    <ProjectHero project={project} v={v} poster={poster} />
    <CaseStudy project={project} />
    <ProjectExplore project={project} v={v} />

    <Revisions revisions={d.revisions} />

    <div class="body">
      <aside class="side">
        <div class="side-inner">
          {toc.length > 0 && (
            <nav aria-label="Sections on this page">
              <p class="label">Sections</p>
              <ol>
                {toc.map((h, i) => (
                  <li><a href={`#${h.slug}`}><span class="mono">{String(i + 1).padStart(2, '0')}</span>{h.text}</a></li>
                ))}
              </ol>
            </nav>
          )}
          {d.skills.length > 0 && (
            <div><p class="label">Skills shown</p><p class="small">{d.skills.join(', ')}</p></div>
          )}
          {d.downloads.length > 0 && (
            <div>
              <p class="label">Files</p>
              <ul class="dl">{d.downloads.map((f) => <li><a href={f.file} download>{f.label} ↓</a></li>)}</ul>
            </div>
          )}
          {d.credit && (<div><p class="label">Credit</p><p class="small">{d.credit}</p></div>)}
        </div>
      </aside>

      <div class="prose">
        {sections.map((s) => (
          <section class="cms-section" data-kind={s.kind}>
            <h2 id={s.slug}>{s.title}</h2>
            <Fragment set:html={s.html} />
            {s.image && (
              <figure class="fig">
                <img src={s.image} alt={s.caption ?? s.title} loading="lazy" />
                {s.caption && <figcaption class="mono">{s.caption}</figcaption>}
              </figure>
            )}
          </section>
        ))}
        <Content />
        {d.gallery.length > 0 && (
          <>
            <h2 id="gallery">Gallery</h2>
            <div class="gallery">
              {d.gallery.map((g) => (
                <figure class="fig">
                  {g.kind === 'Video'
                    ? <video src={g.src} controls preload="metadata" playsinline></video>
                    : <img src={g.src} alt={g.caption || `${d.title}, ${g.kind.toLowerCase()}`} loading="lazy" />}
                  {g.caption && <figcaption class="mono"><span class="label">{g.kind}</span> {g.caption}</figcaption>}
                </figure>
              ))}
            </div>
          </>
        )}
      </div>
    </div>

    {(relatedCad.length > 0 || relatedNotes.length > 0) && (
      <section class="related">
        <div class="section-head"><span class="label">Linked</span><h2>From the CAD library and notebook</h2><span></span></div>
        <ul>
          {relatedCad.map((c) => (
            <li><a href={`/cad/${c.id}/`}><span class="mono">{c.data.number}</span> {c.data.title} <span class="label">CAD · {c.data.kind}</span></a></li>
          ))}
          {relatedNotes.map((n) => (
            <li><a href={`/notebook/${n.id}/`}><span class="mono">{fmtDay(n.data.date)}</span> {n.data.title} <span class="label">Notebook · {n.data.type}</span></a></li>
          ))}
        </ul>
      </section>
    )}

    <!-- Switch between projects without going back to the index -->
    {all.length > 1 && (
      <nav class="switch" aria-label="Other projects">
        <a class="switch-end" href={`/work/${prev.id}/`} rel="prev"><span aria-hidden="true">←</span><span class="label">Previous</span></a>
        <ol>
          {all.map((p) => (
            <li><a href={`/work/${p.id}/`} aria-current={p.id === project.id ? 'page' : undefined} title={p.data.title}><span class="mono">{p.data.number}</span><span class="t">{p.data.title}</span>{plan(p.data).hero === 'assembly' && <span class="dot" aria-label="interactive 3D"></span>}</a></li>
          ))}
        </ol>
        <a class="switch-end" href="/work/"><span class="label">All work</span></a>
      </nav>
    )}

    <a class="next" href={`/work/${next.id}/`} rel="next">
      <span class="label">Next entry</span>
      <span class="next-title"><span class="mono">{next.data.number}</span>{next.data.title} →</span>
    </a>
  </article>
</Base>

<style>
  .p-head { padding-block: clamp(28px, 5vw, 72px) clamp(24px, 3vw, 40px); display: grid; gap: 14px; }
  .back { text-decoration: none; width: fit-content; }
  .p-num { display: flex; gap: 12px; align-items: center; color: var(--accent-ink); font-size: 0.85rem; }
  .p-head h1 { max-width: 16ch; }
  .p-cat { padding: 3px 8px; border: var(--bw) solid var(--rule); border-radius: 999px; font-size: 0.7rem; color: var(--graphite); letter-spacing: 0.04em; }

  .switch { display: flex; align-items: stretch; gap: 0; margin-top: clamp(56px, 8vw, 100px); border-top: var(--bw) solid var(--rule); border-bottom: var(--bw) solid var(--rule); }
  .switch ol { list-style: none; margin: 0; padding: 0; display: flex; flex: 1; overflow-x: auto; scrollbar-width: thin; }
  .switch li { flex: 1 1 0; min-width: 150px; }
  .switch li a, .switch-end { display: flex; align-items: center; gap: 8px; height: 100%; padding: 12px 14px; text-decoration: none; border-right: var(--bw) solid var(--rule); font-family: var(--f-heading); font-size: 0.9rem; }
  .switch li a .t { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .switch li a .mono { font-size: 0.72rem; color: var(--graphite); flex: none; }
  .switch li a[aria-current='page'] { background: var(--surface); box-shadow: inset 0 -2px 0 var(--accent); }
  .switch li a:hover { background: var(--surface); }
  .switch .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); flex: none; }
  .switch-end { flex: none; white-space: nowrap; }
  .switch-end:last-child { border-right: 0; border-left: var(--bw) solid var(--rule); }
  .switch + .next { margin-top: 0; border-top: 0; }
  @media (max-width: 760px) { .switch li { min-width: 92px; } .switch li a .t { display: none; } .switch-end .label { display: none; } }
  .p-sum { font-size: clamp(1.1rem, 1rem + 0.5vw, 1.35rem); max-width: 50ch; color: var(--graphite); margin: 0; }

  .tblock {
    display: grid; grid-template-columns: repeat(5, minmax(0, 1fr));
    margin: 0 0 clamp(24px, 3vw, 40px);
    border-top: calc(var(--bw) * 1.5) solid var(--ink); border-left: var(--bw) solid var(--rule);
  }
  .tblock > div { padding: 10px 12px 12px; border-right: var(--bw) solid var(--rule); border-bottom: var(--bw) solid var(--rule); min-width: 0; }
  .tblock .wide { grid-column: span 5; display: grid; grid-template-columns: 9rem 1fr; align-items: baseline; }
  .tblock dt { margin-bottom: 4px; }
  .tblock dd { margin: 0; font-family: var(--f-heading); font-weight: 550; font-size: 1rem; }
  .tblock .rev { font-weight: 750; font-size: 1.3rem; line-height: 1; color: var(--accent-ink); }
  @media (max-width: 760px) {
    .tblock { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .tblock .wide { grid-column: span 2; grid-template-columns: 1fr; }
  }

  .hero > :global(.mv) + .parts { margin-top: clamp(32px, 5vw, 64px); }
  .parts .section-head { margin-bottom: 16px; }
  .models { display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); gap: var(--gap); }
  .model-label { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 12px; margin: 0 0 10px; font-family: var(--f-heading); font-size: 1.1rem; }
  .model-label .mono { font-size: 0.75rem; color: var(--graphite); }
  .models :global(model-viewer) { height: clamp(300px, 34vw, 520px); }
  @media (max-width: 860px) { .models { grid-template-columns: 1fr; } }
  .fig { margin: 2em 0; }
  .fig img, .fig video { width: 100%; border: var(--bw) solid var(--rule); border-radius: var(--radius); background: var(--surface); }
  .fig figcaption { margin-top: 8px; font-size: 0.75rem; color: var(--graphite); }
  .gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr)); gap: 14px; }
  .gallery .fig { margin: 0; }
  .gallery img { aspect-ratio: 4 / 3; object-fit: cover; cursor: zoom-in; }
  .hero { margin-bottom: clamp(24px, 4vw, 48px); }

  .body { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 9fr); gap: clamp(24px, 4vw, 64px); margin-top: 1rem; }
  .side-inner { position: sticky; top: 24px; display: grid; gap: 28px; }
  .side ol, .side ul { list-style: none; margin: 0; padding: 0; }
  .side nav a { display: flex; gap: 10px; padding: 6px 0; text-decoration: none; font-family: var(--f-heading); font-size: 0.95rem; border-bottom: var(--bw) solid var(--rule); }
  .side nav a .mono { color: var(--graphite); }
  .side .label { margin-bottom: 8px; }
  .small { font-size: 0.92rem; color: var(--graphite); line-height: 1.45; margin: 0; }
  .dl a { font-family: var(--f-mono); font-size: 0.8rem; }
  .prose :global(h2:first-child) { margin-top: 0; }
  @media (max-width: 860px) {
    .body { grid-template-columns: 1fr; }
    .side-inner { position: static; }
    .side nav { display: none; }
  }

  .related { margin-top: clamp(56px, 8vw, 100px); }
  .related ul { list-style: none; margin: 0; padding: 0; }
  .related a { display: flex; flex-wrap: wrap; gap: 6px 14px; align-items: baseline; padding: 14px 0; border-bottom: var(--bw) solid var(--rule); text-decoration: none; font-family: var(--f-heading); font-size: 1.1rem; }
  .related .label { margin-left: auto; }

  .next {
    display: grid; gap: 8px; margin-top: clamp(56px, 8vw, 100px);
    padding: clamp(20px, 3vw, 36px) 0; border-top: var(--bw) solid var(--ink); border-bottom: var(--bw) solid var(--ink);
    text-decoration: none;
  }
  .next-title { font-family: var(--f-display); font-size: var(--t-h2); font-weight: var(--w-heading); font-stretch: calc(var(--stretch) - 10%); letter-spacing: calc(var(--track) - 0.01em); line-height: 1.05; display: flex; gap: 0.5em; align-items: baseline; flex-wrap: wrap; transition: transform calc(0.4s * var(--speed)) var(--ease); }
  .next-title .mono { font-size: 0.9rem; color: var(--graphite); }
  .next:hover .next-title { transform: translateX(calc(12px * var(--hover-k))); }
</style>
