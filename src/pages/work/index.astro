---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { getProjects } from '../../lib/content';
import { DISCIPLINES, CONTEXTS } from '../../content.config';

const projects = await getProjects();
// Only offer filters that at least one project uses.
const usedD = DISCIPLINES.filter((d) => projects.some((p) => p.data.disciplines.includes(d)));
const usedC = CONTEXTS.filter((c) => projects.some((p) => p.data.context === c));
---
<Base title="Work" sheet="02 · Work index" description="Index of Muhammad Ali's engineering projects: CAD, robotics, motorsport, aerospace and data.">
  <section class="wrap">
    <header class="page-head">
      <span class="label">01 / Work</span>
      <h1>Index of work</h1>
      <p>Every project gets a number and stays here, finished or not. Filter by discipline or by where the work came from.</p>
    </header>

    <div class="filters" role="group" aria-label="Filter projects">
      <div class="fgroup" data-group="d">
        <span class="label">Discipline</span>
        <button type="button" class="btn" data-value="" aria-pressed="true">All</button>
        {usedD.map((d) => <button type="button" class="btn" data-value={d} aria-pressed="false">{d}</button>)}
      </div>
      <div class="fgroup" data-group="c">
        <span class="label">Context</span>
        <button type="button" class="btn" data-value="" aria-pressed="true">All</button>
        {usedC.map((c) => <button type="button" class="btn" data-value={c} aria-pressed="false">{c}</button>)}
      </div>
    </div>

    <p class="count label" aria-live="polite"><span>{projects.length}</span> of {projects.length} entries</p>

    <ol class="index">
      <li class="row head label" aria-hidden="true">
        <span>No.</span><span>Title</span><span>Discipline</span><span>Context</span><span>Status</span><span>Started</span>
      </li>
      {projects.map((p) => (
        <li class="row" data-d={p.data.disciplines.join('|')} data-c={p.data.context}>
          <a href={`/work/${p.id}/`}>
            <span class="mono no">{p.data.number}</span>
            <span class="title">
              <strong>{p.data.title}</strong>
              {p.data.sample && <span class="sample-tag">Sample</span>}
              <span class="summary">{p.data.summary}</span>
            </span>
            <span class="mono disc">{p.data.disciplines.slice(0, 2).join(', ')}</span>
            <span class="mono ctx">{p.data.context}</span>
            <span class="mono status" data-status={p.data.status}>{p.data.status}</span>
            <span class="mono yr">{p.data.date.getUTCFullYear()}</span>
          </a>
          {p.data.cover && (
            <template>
              <Image src={p.data.cover} alt="" width={480} />
            </template>
          )}
        </li>
      ))}
    </ol>
    <p class="empty-msg" hidden>Nothing matches that combination yet. Which means there is a project to go build.</p>
  </section>

  <!-- floating preview that follows the cursor on desktop -->
  <div class="peek" aria-hidden="true"><div class="peek-inner"></div><span class="peek-no mono"></span></div>
</Base>

<script>
  const rows = [...document.querySelectorAll<HTMLLIElement>('.index .row:not(.head)')];
  const countEl = document.querySelector('.count span')!;
  const emptyMsg = document.querySelector<HTMLElement>('.empty-msg')!;
  const state: Record<string, string> = { d: '', c: '' };

  function apply() {
    let shown = 0;
    for (const r of rows) {
      const ok = (!state.d || r.dataset.d!.split('|').includes(state.d)) && (!state.c || r.dataset.c === state.c);
      r.hidden = !ok;
      if (ok) shown++;
    }
    countEl.textContent = String(shown);
    emptyMsg.hidden = shown > 0;
    const q = new URLSearchParams();
    if (state.d) q.set('d', state.d);
    if (state.c) q.set('c', state.c);
    history.replaceState(null, '', q.size ? `?${q}` : location.pathname);
  }

  for (const group of document.querySelectorAll<HTMLElement>('.fgroup')) {
    const key = group.dataset.group!;
    const buttons = [...group.querySelectorAll<HTMLButtonElement>('button')];
    const select = (val: string) => {
      state[key] = val;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.value === val)));
    };
    buttons.forEach((b) => b.addEventListener('click', () => { select(b.dataset.value!); apply(); }));
    // restore from the URL so filtered views can be shared as links
    const fromUrl = new URLSearchParams(location.search).get(key);
    if (fromUrl && buttons.some((b) => b.dataset.value === fromUrl)) select(fromUrl);
  }
  apply();

  // Hover preview, only for mouse users.
  const peek = document.querySelector<HTMLElement>('.peek')!;
  const inner = peek.querySelector<HTMLElement>('.peek-inner')!;
  const peekNo = peek.querySelector<HTMLElement>('.peek-no')!;
  if (matchMedia('(pointer: fine)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let x = 0, y = 0, tx = 0, ty = 0, raf = 0;
    const loop = () => {
      x += (tx - x) * 0.18; y += (ty - y) * 0.18;
      peek.style.transform = `translate(${x}px, ${y}px)`;
      raf = Math.abs(tx - x) + Math.abs(ty - y) > 0.5 ? requestAnimationFrame(loop) : 0;
    };
    for (const r of rows) {
      r.addEventListener('pointerenter', () => {
        const tpl = r.querySelector('template');
        inner.replaceChildren(tpl ? tpl.content.cloneNode(true) : document.createTextNode(''));
        inner.classList.toggle('blank', !tpl);
        peekNo.textContent = r.querySelector('.no')!.textContent;
        peek.classList.add('on');
      });
      r.addEventListener('pointerleave', () => peek.classList.remove('on'));
      r.addEventListener('pointermove', (e) => {
        tx = e.clientX + 24; ty = e.clientY - 90;
        if (!raf) raf = requestAnimationFrame(loop);
      });
    }
  }
</script>

<style>
  .page-head { padding-block: clamp(32px, 6vw, 88px) clamp(24px, 4vw, 48px); display: grid; gap: 14px; max-width: 900px; }
  .page-head p { color: var(--graphite); max-width: 52ch; margin: 0; }

  .filters { display: grid; gap: 10px; border-top: var(--bw) solid var(--ink); padding-top: 16px; }
  .fgroup { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
  .fgroup .label { width: 7.5rem; flex-shrink: 0; }
  .fgroup button { font-family: var(--f-mono); font-size: 0.72rem; padding: 5px 10px; }
  @media (max-width: 640px) { .fgroup .label { width: 100%; } }
  .count { margin: 28px 0 8px; }

  .index { list-style: none; margin: 0; padding: 0; }
  .row a, .row.head {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr) 11rem 8rem 7.5rem 3.5rem;
    gap: 1rem; align-items: baseline;
    padding: 16px 0; border-bottom: var(--bw) solid var(--rule);
    text-decoration: none;
  }
  .row.head { padding: 8px 0; border-bottom-color: var(--ink); }
  .row a { transition: background calc(0.2s * var(--speed)), padding calc(0.3s * var(--speed)) var(--ease); }
  .row a:hover { color: inherit; background: color-mix(in srgb, var(--highlight) 6%, var(--paper-2)); padding-left: calc(5px * var(--hover-k)); }
  .row a:hover .no { color: var(--accent-ink); }
  .title { display: grid; gap: 4px; justify-items: start; }
  .title strong { font-family: var(--f-heading); font-size: 1.3rem; font-weight: 600; letter-spacing: -0.01em; line-height: 1.15; }
  .summary { color: var(--graphite); font-size: 0.95rem; line-height: 1.4; max-width: 60ch; }
  .disc, .ctx, .yr { color: var(--graphite); }
  .yr { text-align: right; padding-right: 8px; }
  .row[hidden] { display: none; }
  @media (max-width: 1000px) {
    .row a, .row.head { grid-template-columns: 5rem minmax(0, 1fr) 7.5rem; }
    .disc, .ctx, .yr, .row.head span:nth-child(n+3):not(:nth-child(5)) { display: none; }
  }
  @media (max-width: 560px) {
    .row.head { display: none; }
    .row a { grid-template-columns: 1fr auto; gap: 6px 1rem; }
    .row .title { grid-column: 1 / -1; grid-row: 2; }
  }
  .empty-msg { padding: 32px 0; color: var(--graphite); }

  .peek {
    position: fixed; left: 0; top: 0; width: 240px; z-index: 50; pointer-events: none;
    opacity: 0; scale: calc(1 - 0.03 * var(--hover-k)); transition: opacity calc(0.2s * var(--speed)), scale calc(0.25s * var(--speed)) var(--ease);
  }
  .peek.on { opacity: 1; scale: 1; }
  .peek-inner { aspect-ratio: 4 / 3; background: var(--surface); border: var(--bw) solid var(--ink); border-radius: var(--radius); box-shadow: var(--shadow); overflow: hidden; }
  .peek-inner :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .peek-inner.blank {
    background:
      linear-gradient(var(--rule), var(--rule)) center / 100% 1px no-repeat,
      linear-gradient(var(--rule), var(--rule)) center / 1px 100% no-repeat,
      var(--paper-2);
  }
  .peek-no { position: absolute; left: 0; bottom: -22px; background: var(--ink); color: var(--paper); padding: 2px 6px; font-size: 0.68rem; }
</style>
