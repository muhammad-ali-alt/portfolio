---
// The notebook index: every published entry, searchable and filterable.
// Each entry has its own page at /notebook/<entry>/.
import Base from '../../layouts/Base.astro';
import { getNotebook, fmtDay, linkedProject } from '../../lib/content';

const entries = await getNotebook();
const rows = await Promise.all(entries.map(async (e) => ({ e, project: await linkedProject(e.data.project) })));
const types = [...new Set(entries.map((e) => e.data.type))].sort();
const tags = [...new Set(entries.flatMap((e) => e.data.tags))].sort();
const projects = [...new Map(rows.filter((r) => r.project).map((r) => [r.project!.id, r.project!])).values()];
---
<Base title="Notebook" sheet="04 · Notebook" description="Engineering notebook: experiments, failures, calculations and lessons learned.">
  <section class="wrap">
    <header class="page-head" data-edit="/admin/#/collections/notebook/new" data-edit-label="New notebook entry">
      <span class="label">03 / Notebook</span>
      <h1>Notebook</h1>
      <p>The process behind the work. Experiments, failed attempts, quick calculations and things I learned the hard way.</p>
    </header>

    <form class="tools" role="search" onsubmit="return false">
      <label class="search">
        <span class="visually-hidden">Search the notebook</span>
        <input type="search" id="nb-q" placeholder="Search entries" autocomplete="off" />
      </label>
      <label><span class="label">Category</span>
        <select id="nb-type"><option value="">All</option>{types.map((t) => <option>{t}</option>)}</select>
      </label>
      {tags.length > 0 && (
        <label><span class="label">Tag</span>
          <select id="nb-tag"><option value="">All</option>{tags.map((t) => <option>{t}</option>)}</select>
        </label>
      )}
      {projects.length > 0 && (
        <label><span class="label">Project</span>
          <select id="nb-proj"><option value="">All</option>{projects.map((p) => <option value={p.id}>{p.data.number} {p.data.title}</option>)}</select>
        </label>
      )}
      <label><span class="label">Sort</span>
        <select id="nb-sort"><option value="new">Newest first</option><option value="old">Oldest first</option></select>
      </label>
    </form>
    <p class="count label" aria-live="polite"><span id="nb-count">{entries.length}</span> of {entries.length} entries</p>

    <ol class="log" id="nb-log">
      {rows.map(({ e, project }) => (
        <li
          data-type={e.data.type} data-tags={e.data.tags.join('|')} data-proj={project?.id ?? ''}
          data-date={e.data.date.valueOf()} data-pinned={e.data.pinned ? '1' : ''}
          data-text={`${e.data.title} ${e.data.summary ?? ''} ${e.data.tags.join(' ')} ${e.body ?? ''}`.toLowerCase()}
          data-edit={`/admin/#/collections/notebook/entries/${e.id}`} data-edit-label="Edit entry"
        >
          <a href={`/notebook/${e.id}/`}>
            <span class="mono date">{fmtDay(e.data.date)}</span>
            <span class="type mono" data-type={e.data.type}>{e.data.type}</span>
            <span class="t">
              <strong>{e.data.pinned && <span class="pin" title="Pinned">◆ </span>}{e.data.title}</strong>
              {e.data.summary && <span class="s">{e.data.summary}</span>}
              {(project || e.data.tags.length > 0) && (
                <span class="meta mono">{project && <span>{project.data.number}</span>}{e.data.tags.map((t) => <span>#{t}</span>)}</span>
              )}
            </span>
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ol>
    <p class="empty" id="nb-empty" hidden>No entries match. Try a different search or filter.</p>
  </section>
</Base>

<script>
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;
  const list = $('nb-log')!;
  const rows = [...list.children] as HTMLLIElement[];
  const q = $<HTMLInputElement>('nb-q')!, type = $<HTMLSelectElement>('nb-type'), tag = $<HTMLSelectElement>('nb-tag');
  const proj = $<HTMLSelectElement>('nb-proj'), sort = $<HTMLSelectElement>('nb-sort')!;
  const params = new URLSearchParams(location.search);
  // Filters can come from a link, e.g. /notebook/?project=robotic-arm
  if (params.get('project') && proj) proj.value = params.get('project')!;
  if (params.get('tag') && tag) tag.value = params.get('tag')!;
  if (params.get('type') && type) type.value = params.get('type')!;

  function apply() {
    const words = q.value.toLowerCase().split(/\s+/).filter(Boolean);
    let shown = 0;
    for (const r of rows) {
      const ok =
        words.every((w) => r.dataset.text!.includes(w)) &&
        (!type?.value || r.dataset.type === type.value) &&
        (!tag?.value || r.dataset.tags!.split('|').includes(tag.value)) &&
        (!proj?.value || r.dataset.proj === proj.value);
      r.hidden = !ok;
      if (ok) shown++;
    }
    const dir = sort.value === 'old' ? 1 : -1;
    rows
      .sort((a, b) => Number(!!b.dataset.pinned) - Number(!!a.dataset.pinned) || dir * (+a.dataset.date! - +b.dataset.date!))
      .forEach((r) => list.append(r));
    $('nb-count')!.textContent = String(shown);
    $('nb-empty')!.hidden = shown > 0;
  }
  [q, type, tag, proj, sort].forEach((el) => el?.addEventListener('input', apply));
  apply();
</script>

<style>
  .page-head { padding-block: clamp(32px, 6vw, 88px) clamp(24px, 4vw, 48px); display: grid; gap: 14px; }
  .page-head p { color: var(--graphite); max-width: 52ch; margin: 0; }
  .tools { display: flex; flex-wrap: wrap; gap: 12px 16px; align-items: end; border-top: var(--bw) solid var(--ink); padding-top: 16px; }
  .tools label { display: grid; gap: 4px; }
  .tools select, .tools input {
    font: inherit; font-size: 0.95rem; color: var(--ink); background: var(--paper);
    border: var(--bw) solid var(--rule); border-radius: var(--radius-btn); padding: 7px 10px;
  }
  .search { flex: 1 1 240px; }
  .search input { width: 100%; }
  .count { margin: 24px 0 8px; }
  .log { list-style: none; margin: 0; padding: 0; border-top: var(--bw) solid var(--ink); }
  .log > li { border-bottom: var(--bw) solid var(--rule); }
  .log > li[hidden] { display: none; }
  .log a {
    display: grid; grid-template-columns: 7rem 9rem minmax(0, 1fr) 24px; gap: 1rem; align-items: baseline;
    padding: 18px 0; text-decoration: none; transition: background calc(0.2s * var(--speed)), padding calc(0.3s * var(--speed)) var(--ease);
  }
  .log a:hover { color: inherit; background: color-mix(in srgb, var(--highlight) 6%, var(--paper-2)); padding-left: calc(5px * var(--hover-k)); }
  .log a:hover strong { color: var(--accent-ink); }
  .date { color: var(--graphite); }
  .type { display: inline-flex; align-items: center; gap: 8px; }
  .type::before { content: ''; width: 8px; height: 8px; display: inline-block; background: var(--tertiary); border-radius: min(var(--radius-btn), 4px); }
  .type[data-type='Failure']::before { background: var(--accent); }
  .type[data-type='Experiment']::before, .type[data-type='Design Log']::before { background: var(--secondary); }
  .type[data-type='Idea']::before { background: transparent; border: var(--bw) solid var(--tertiary); }
  .t { display: grid; gap: 4px; justify-items: start; }
  .t strong { font-family: var(--f-heading); font-size: 1.25rem; font-weight: 600; line-height: 1.2; }
  .pin { color: var(--accent-ink); font-size: 0.8em; }
  .s { color: var(--graphite); font-size: 0.95rem; }
  .meta { display: flex; gap: 10px; flex-wrap: wrap; color: var(--graphite); font-size: 0.72rem; }
  .arrow { color: var(--graphite); }
  .empty { padding: 32px 0; color: var(--graphite); }
  @media (max-width: 760px) {
    .log a { grid-template-columns: 1fr auto; }
    .t { grid-column: 1 / -1; grid-row: 2; }
    .type, .arrow { display: none; }
  }
</style>
