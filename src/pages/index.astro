---
import Base from '../layouts/Base.astro';
import Plate from '../components/Plate.astro';
import ProfileCard from '../components/ProfileCard.astro';
import AsciiPond from '../components/AsciiPond.astro';
import { site, about, home, homeSection } from '../lib/data';
import { mdInline } from '../lib/markdown';
import { getProjects, getFeatured, getToolUsage, getCad, getNotebook, fmtMonth } from '../lib/content';

const projects = await getProjects();
const featured = (await getFeatured()).slice(0, 4);
const current = projects.find((p) => p.data.status === 'In progress' && !p.data.sample);
const cad = await getCad();
const notes = await getNotebook();
const tools = [...(await getToolUsage()).entries()].sort((a, b) => b[1].length - a[1].length);

// Table of contents with live counts
const contents = [
  { n: '01', title: 'Work', href: '/work/', desc: 'Projects, from idea to finished part', count: projects.length },
  { n: '02', title: 'CAD', href: '/cad/', desc: 'Parts, assemblies and mechanisms in 3D', count: cad.length },
  { n: '03', title: 'Notebook', href: '/notebook/', desc: 'Experiments, failures and things learned', count: notes.length },
  { n: '04', title: 'Toolbox', href: '/toolbox/', desc: 'Software and methods, backed by projects', count: tools.length },
  { n: '05', title: 'About', href: '/about/', desc: 'Who is behind the work', count: null },
];
const [lead, ...rest] = featured;
---
<Base sheet="01 · Cover">
  <!-- COVER ─────────────────────────────────────────── -->
  <section class="cover wrap" aria-labelledby="name">
    <div class="frame">
      {home.heroArt && home.heroImage && <AsciiPond src={home.heroImage} alt={home.heroImageAlt} />}
      <div class="zones zones-top mono detail-minor" aria-hidden="true">{[1, 2, 3, 4, 5, 6].map((n) => <span>{n}</span>)}</div>
      <div class="zones zones-side mono detail-minor" aria-hidden="true">{['A', 'B', 'C', 'D'].map((n) => <span>{n}</span>)}</div>

      <div class="cover-meta label">
        <span>{site.school}</span>
        <span class="detail">38.99° N, 76.94° W</span>
        <span class="cursor-zone detail-minor" aria-hidden="true">Zone —</span>
      </div>

      <h1 id="name" class="name display">
        <span>Muhammad</span>
        <span>Ali<span class="accent">.</span></span>
      </h1>

      <div class="dim detail" aria-hidden="true">
        <span class="dim-line"></span>
        <span class="dim-val mono">— mm</span>
        <span class="dim-line"></span>
      </div>

      <div class="cover-foot">
        <p class="lede" data-edit="/admin/#/collections/pages/entries/home" data-edit-label="Edit introduction">{home.lede}</p>
        {current && (
          <a class="now" href={`/work/${current.id}/`}>
            <span class="label">On the bench now</span>
            <span class="now-title">
              <span class="mono">{current.data.number}</span> {current.data.title}
            </span>
            <span class="status mono" data-status={current.data.status}>{current.data.status}</span>
          </a>
        )}
      </div>
    </div>
  </section>

  <!-- Home sections: order, titles and visibility come from src/data/home.json (CMS: Site and About, Home page) -->
  {home.sections.filter((sec) => sec.visible).map(({ id }) => (
    <Fragment>
      {id === 'contents' && (
  <section class="wrap toc" aria-labelledby="toc-h">
    <div class="section-head">
      <span class="label">{homeSection('contents').label}</span>
      <h2 id="toc-h">{homeSection('contents').title}</h2>
      <span class="label">{projects.length + cad.length + notes.length} entries</span>
    </div>
    <ol class="toc-list">
      {contents.map((c) => (
        <li>
          <a href={c.href}>
            <span class="mono toc-n">{c.n}</span>
            <span class="toc-title">{c.title}</span>
            <span class="toc-desc">{c.desc}</span>
            <span class="mono toc-count">{c.count !== null ? String(c.count).padStart(2, '0') : '→'}</span>
          </a>
        </li>
      ))}
    </ol>
  </section>
      )}
      {id === 'featured' && (
  <section class="wrap featured" aria-labelledby="feat-h">
    <div class="section-head">
      <span class="label">{homeSection('featured').label}</span>
      <h2 id="feat-h">{homeSection('featured').title}</h2>
      <a class="label" href="/work/">Full index →</a>
    </div>

    <div class="feat-grid" data-edit="/admin/#/collections/projects" data-edit-label="Manage projects">
      {lead && (
        <a class="lead card" href={`/work/${lead.id}/`} style="--i: 0">
          <Plate src={lead.data.cover} alt={lead.data.coverAlt} number={lead.data.number} ratio="3 / 2" eager sizes="(max-width: 900px) 100vw, 60vw" />
          <div class="card-meta">
            <span class="mono">{lead.data.number}</span>
            <span class="status mono" data-status={lead.data.status}>{lead.data.status}</span>
          </div>
          <h3>{lead.data.title}</h3>
          <p>{lead.data.summary}</p>
        </a>
      )}
      <div class="rest">
        {rest.map((p, i) => (
          <a class="card small" href={`/work/${p.id}/`} style={`--i: ${i + 1}`}>
            <Plate src={p.data.cover} alt={p.data.coverAlt} number={p.data.number} ratio="16 / 10" sizes="(max-width: 900px) 100vw, 35vw" />
            <div>
              <div class="card-meta">
                <span class="mono">{p.data.number}</span>
                <span class="mono ctx">{p.data.context}</span>
                <span class="status mono" data-status={p.data.status}>{p.data.status}</span>
              </div>
              <h3>{p.data.title}</h3>
              <p class="sum">{p.data.summary}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
      )}
      {id === 'fields' && (
  <section class="wrap fields" aria-labelledby="fields-h">
    <div class="section-head">
      <span class="label">{homeSection('fields').label}</span>
      <h2 id="fields-h">{homeSection('fields').title}</h2>
      <a class="label" href="/toolbox/">Toolbox →</a>
    </div>
    <div class="fields-grid">
      <p class="big-statement" set:html={mdInline(home.statement)} />
      <ul class="tool-list">
        {tools.map(([name, ps]) => (
          <li>
            <span class="tool-name">{ps[0].data.tools.find((t) => t.toLowerCase() === name)}</span>
            <span class="mono">{ps.map((p) => p.data.number).join(' ')}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>
      )}
      {id === 'about' && (
  <section class="wrap about-t" aria-labelledby="about-h">
    <div class="section-head">
      <span class="label">{homeSection('about').label}</span>
      <h2 id="about-h">{homeSection('about').title}</h2>
      <a class="label" href="/about/">Read more →</a>
    </div>
    <div class="about-grid" data-edit="/admin/#/collections/pages/entries/about" data-edit-label="Edit about">
      <div class="about-left">
        <p class="about-intro">{about.intro}</p>
        <dl class="specs">
        {about.callouts.map((c) => (
          <div><dt class="label">{c.label}</dt><dd>{c.value}</dd></div>
        ))}
      </dl>
      </div>
      <ProfileCard />
    </div>
  </section>
      )}
    </Fragment>
  ))}
</Base>

<script>
  // Live dimension under the name: measures the real width of the
  // heading and converts CSS pixels to millimetres (96 px = 25.4 mm).
  const name = document.querySelector<HTMLElement>('.name');
  const val = document.querySelector<HTMLElement>('.dim-val');
  const dim = document.querySelector<HTMLElement>('.dim');
  if (name && val && dim) {
    const measure = () => {
      const spans = [...name.children] as HTMLElement[];
      const w = Math.max(...spans.map((s) => s.getBoundingClientRect().width));
      dim.style.width = `${w}px`;
      val.textContent = `${((w * 25.4) / 96).toFixed(1)} mm`;
    };
    new ResizeObserver(measure).observe(name);
    document.fonts.ready.then(measure);
  }

  // Cursor zone readout, like the zone grid on a drawing border.
  const frame = document.querySelector<HTMLElement>('.frame');
  const zone = document.querySelector<HTMLElement>('.cursor-zone');
  if (frame && zone && matchMedia('(pointer: fine)').matches) {
    frame.addEventListener('pointermove', (e) => {
      const r = frame.getBoundingClientRect();
      const col = Math.min(6, Math.floor(((e.clientX - r.left) / r.width) * 6) + 1);
      const row = 'ABCD'[Math.min(3, Math.floor(((e.clientY - r.top) / r.height) * 4))];
      zone.textContent = `Zone ${row}${col}`;
    });
    frame.addEventListener('pointerleave', () => (zone.textContent = 'Zone —'));
  }
</script>

<style>
  /* cover */
  .cover { padding-top: clamp(8px, 2vw, 24px); }
  .frame {
    position: relative;
    border: var(--bw) solid var(--ink);
    padding: clamp(20px, 4vw, 56px) clamp(20px, 4vw, 56px) clamp(24px, 4vw, 48px) clamp(34px, 5vw, 72px);
    min-height: min(82vh, 860px);
    background-image: var(--g-hero);
    display: grid;
    grid-template-rows: auto 1fr auto auto;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(16px, 3vw, 32px);
  }
  /* cover content sits above the animated mosaic (the zone markers keep their own positioning) */
  .frame > :not(.pond):not(.zones) { position: relative; z-index: 1; }
  .frame > .zones { z-index: 1; }
  .zones { position: absolute; display: flex; color: var(--graphite); font-size: 0.62rem; }
  .zones-top { top: -1.5em; left: 0; right: 0; justify-content: space-around; }
  .zones-side { top: 0; bottom: 0; left: 8px; flex-direction: column; justify-content: space-around; }
  .zones-side::after { content: ''; position: absolute; top: 0; bottom: 0; left: calc(100% + 8px); border-left: var(--bw) solid var(--rule); }
  .cover-meta { display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .cursor-zone { min-width: 7ch; text-align: right; color: var(--accent-ink); }
  @media (max-width: 640px) { .cursor-zone, .zones-top { display: none; } }

  .name {
    align-self: end;
    font-size: min(calc(clamp(2.4rem, 12.6vw, 13rem) * var(--h-scale)), 13.5vw);
    line-height: 0.86;
    will-change: transform;
    display: grid;
  }
  .name > span { width: fit-content; }
  .name > span:nth-child(2) { padding-left: 0.5em; }

  .dim { display: flex; align-items: center; gap: 10px; color: var(--accent-ink); max-width: 100%; }
  .dim-line { flex: 1; height: 9px; position: relative; }
  .dim-line::before { content: ''; position: absolute; left: 0; right: 0; top: 4px; border-top: 1px solid currentColor; }
  .dim-line:first-child { border-left: 1px solid currentColor; }
  .dim-line:last-child { border-right: 1px solid currentColor; }
  .dim-line:first-child::after, .dim-line:last-child::after {
    content: ''; position: absolute; top: 1px; width: 0; height: 0;
    border-block: 3.5px solid transparent;
  }
  .dim-line:first-child::after { left: 0; border-right: 8px solid currentColor; }
  .dim-line:last-child::after { right: 0; border-left: 8px solid currentColor; }
  .dim-val { font-size: 0.72rem; white-space: nowrap; }

  .cover-foot {
    display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: clamp(20px, 4vw, 64px); align-items: end;
    padding-top: clamp(12px, 2vw, 24px); border-top: var(--bw) solid var(--rule);
  }
  .lede { font-size: clamp(1.1rem, 0.95rem + 0.6vw, 1.45rem); line-height: 1.4; max-width: 40ch; margin: 0; }
  .now {
    display: grid; gap: 6px; text-decoration: none; padding: 14px 16px;
    border-left: 3px solid var(--accent); background-color: var(--paper-2); background-image: var(--g-accent);
    border-radius: 0 var(--radius) var(--radius) 0; box-shadow: var(--shadow);
    transition: transform calc(0.3s * var(--speed)) var(--ease);
  }
  .now:hover { color: inherit; transform: translateX(calc(4px * var(--hover-k))); }
  .now-title { font-family: var(--f-heading); font-weight: 600; font-size: 1.1rem; }
  @media (max-width: 760px) { .cover-foot { grid-template-columns: 1fr; } }

  /* sections */
  section + section { margin-top: var(--section-gap); }
  .cover + section { margin-top: calc(var(--section-gap) * 0.8); }

  /* contents */
  .toc-list { list-style: none; margin: 0; padding: 0; }
  .toc-list a {
    display: grid; grid-template-columns: 3rem minmax(0, 1fr) minmax(0, 1.2fr) 3rem;
    align-items: baseline; gap: 1rem; padding: 18px 0; border-bottom: var(--bw) solid var(--rule);
    text-decoration: none; position: relative;
  }
  .toc-list a::after {
    content: ''; position: absolute; left: 0; bottom: -1px; height: 1px; width: 0;
    background: var(--accent); transition: width calc(0.5s * var(--speed)) var(--ease);
  }
  .toc-list a:hover::after { width: 100%; }
  .toc-list a:hover { color: inherit; }
  .toc-title { font-family: var(--f-display); font-size: calc(clamp(1.6rem, 1rem + 2.2vw, 2.8rem) * var(--h-scale)); font-weight: var(--w-heading); font-stretch: calc(var(--stretch) - 8%); letter-spacing: calc(var(--track) - 0.01em); transition: transform calc(0.4s * var(--speed)) var(--ease); }
  .toc-list a:hover .toc-title { transform: translateX(calc(10px * var(--hover-k))); }
  .toc-n, .toc-count { color: var(--graphite); }
  .toc-count { text-align: right; }
  .toc-desc { color: var(--graphite); font-size: 1rem; }
  @media (max-width: 640px) {
    .toc-list a { grid-template-columns: 2rem 1fr 2rem; }
    .toc-desc { grid-column: 2; grid-row: 2; font-size: 0.9rem; }
  }

  /* featured */
  .feat-grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--gap); margin-top: 20px; }
  .card { text-decoration: none; display: grid; gap: 12px; align-content: start; }
  .card:hover { color: inherit; }
  .card:hover :global(.plate img) { transform: scale(calc(1 + 0.03 * var(--hover-k))); }
  .card:hover h3 { color: var(--accent-ink); }
  .card-meta { display: flex; gap: 1rem; align-items: center; color: var(--graphite); font-size: 0.72rem; flex-wrap: wrap; }
  .card-meta .status { margin-left: auto; color: var(--ink); }
  .lead h3 { font-size: var(--t-h2); font-stretch: calc(var(--stretch) - 10%); }
  .lead p { color: var(--graphite); max-width: 52ch; margin: 0; }
  .rest { display: grid; gap: var(--gap); align-content: start; }
  .small { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: start; }
  .small .card-meta { margin-bottom: 8px; }
  .small .ctx { display: none; }
  .sum { display: none; color: var(--graphite); margin: 10px 0 0; max-width: 52ch; }

  /* Stacked cards (Studio: Layout → Stack the featured projects) */
  :global(html[data-stack='on']) .feat-grid { grid-template-columns: 1fr; gap: 0; }
  :global(html[data-stack='on']) .rest { display: contents; }
  :global(html[data-stack='on']) .card {
    /* 36px steps leave a visible strip of every card behind, so none gets fully covered */
    position: sticky; top: calc(84px + var(--i) * 36px);
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); align-items: center; column-gap: var(--gap);
    padding: clamp(14px, 2vw, 28px); margin-bottom: 16vh;
    background-color: var(--paper); border: var(--bw) solid var(--rule); border-radius: calc(var(--radius) * 1.2);
    box-shadow: var(--shadow), 0 -12px 40px rgb(0 0 0 / 0.07);
    /* scrolling shrinks earlier cards behind later ones (scripts/motion.ts sets --stack-scale) */
    transform-origin: top center;
    scale: var(--stack-scale, 1);
    will-change: scale;
  }
  :global(html[data-stack='on']) .card:last-child { margin-bottom: 0; }
  /* Room after the last card so it can rise to its spot and the stack holds before scrolling
     away. Must be a real element: sticky items ignore their container's padding. */
  :global(html[data-stack='on']) .feat-grid::after { content: ''; display: block; height: 65vh; }
  :global(html[data-stack='on']) .card > :global(.plate) { grid-row: span 4; }
  :global(html[data-stack='on']) .small h3 { font-size: var(--t-h2); }
  :global(html[data-stack='on']) .small .ctx { display: inline; }
  :global(html[data-stack='on']) .sum { display: block; }
  @media (max-width: 760px) {
    :global(html[data-stack='on']) .card { position: static; grid-template-columns: 1fr; scale: 1; margin-bottom: var(--gap); }
    :global(html[data-stack='on']) .feat-grid::after { display: none; }
    :global(html[data-stack='on']) .card > :global(.plate) { grid-row: auto; }
  }
  @media (max-width: 900px) { .feat-grid { grid-template-columns: 1fr; } }
  @media (max-width: 480px) { .small { grid-template-columns: 1fr; } }

  /* fields */
  .fields-grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); gap: calc(var(--gap) * 1.6); margin-top: 24px; }
  .big-statement { font-family: var(--f-display); font-size: calc(clamp(1.5rem, 1rem + 2vw, 2.6rem) * var(--h-scale)); font-weight: calc(var(--w-heading) - 100); line-height: 1.15; letter-spacing: var(--track); margin: 0; }
  .big-statement em { font-family: var(--f-text); font-style: italic; font-weight: 400; color: var(--emph); }
  .tool-list { list-style: none; margin: 0; padding: 0; align-self: end; }
  .tool-list li { display: flex; justify-content: space-between; gap: 1rem; padding: 10px 0; border-bottom: var(--bw) solid var(--rule); }
  .tool-list li:first-child { border-top: var(--bw) solid var(--rule); }
  .tool-name { font-family: var(--f-heading); font-weight: 550; }
  .tool-list .mono { color: var(--graphite); }
  @media (max-width: 760px) { .fields-grid { grid-template-columns: 1fr; } }

  /* about teaser */
  .about-grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: calc(var(--gap) * 1.6); margin-top: 24px; align-items: start; }
  .about-left { display: grid; gap: 28px; align-content: start; }
  .about-intro { font-size: clamp(1.2rem, 1rem + 0.8vw, 1.6rem); line-height: 1.4; margin: 0; }
  .specs { margin: 0; display: grid; gap: 0; }
  .specs div { display: grid; grid-template-columns: 7rem 1fr; gap: 1rem; padding: 10px 0; border-bottom: var(--bw) solid var(--rule); }
  .specs dd { margin: 0; font-family: var(--f-heading); font-size: 0.98rem; }
  @media (max-width: 760px) { .about-grid { grid-template-columns: 1fr; } }
</style>
