---
// About page, laid out like an assembly drawing of a person:
// numbered balloons on the portrait, a parts list beside it,
// then the story as a magazine spread.
// Portrait: save your photo as src/assets/portrait.jpg (portrait
// orientation, at least 1200 px tall). It appears automatically.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import { about, site, experience, education, achievements } from '../lib/data';
import { md } from '../lib/markdown';

// Portrait: uploaded in the CMS (about.portrait), or src/assets/portrait.jpg as a fallback.
const found = import.meta.glob<{ default: ImageMetadata }>('../assets/portrait.{jpg,jpeg,png,webp}', { eager: true });
const portraitAsset = Object.values(found)[0]?.default;
const isPh = (s: string) => s.startsWith('PLACEHOLDER');
const WORK = ['Job', 'Internship', 'Research'];
const work = experience.filter((e) => WORK.includes(e.type));
const involvement = experience.filter((e) => !WORK.includes(e.type));
---
<Base title="About" sheet="06 · About" description={`About ${site.name}, mechanical engineering student at the ${site.school}.`}>
  <article class="wrap">
    <header class="page-head">
      <span class="label">05 / About</span>
      <h1>General assembly: <span class="serif">one engineer</span></h1>
    </header>

    <!-- SPREAD 1: portrait + parts list -->
    <section class="spread" data-edit="/admin/#/collections/pages/entries/about" data-edit-label="Edit intro and portrait">
      <figure class="portrait">
        <div class="photo">
          {about.portrait ? (
            <img src={about.portrait} alt={`Portrait of ${site.name}`} loading="eager" />
          ) : portraitAsset ? (
            <Image src={portraitAsset} alt={`Portrait of ${site.name}`} widths={[500, 800, 1200]} sizes="(max-width: 860px) 100vw, 45vw" loading="eager" />
          ) : (
            <div class="ph-photo mono">
              <span>Portrait goes here</span>
              <span>Upload one in the CMS: About me, Portrait</span>
            </div>
          )}
          {about.callouts.map((c, i) => (
            <span class="balloon" style={`left:${c.x}%; top:${c.y}%`} data-i={i}>{i + 1}</span>
          ))}
        </div>
        <figcaption class="label">Fig. 1, {site.name}, {site.school}</figcaption>
      </figure>

      <div class="bom">
        <p class="intro">{about.intro}</p>
        <table>
          <caption class="label">Parts list</caption>
          <thead class="label"><tr><th>Item</th><th>Description</th><th>Spec</th></tr></thead>
          <tbody>
            {about.callouts.map((c, i) => (
              <tr data-i={i}><td class="mono">{i + 1}</td><td>{c.label}</td><td>{c.value}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- SPREAD 2: story -->
    <section class="story" data-edit="/admin/#/collections/pages/entries/about" data-edit-label="Edit biography">
      <div class="col-a">
        <h2 class="label">Background</h2>
        <div class="bio" set:html={md(about.story)} />
        <h2 class="label">How I work on problems</h2>
        <p class:list={{ ph: isPh(about.approach) }}>{about.approach}</p>
      </div>
      <div class="col-b">
        <div class="box">
          <h2 class="label">Currently learning</h2>
          <ul>{about.learning.map((x) => <li class:list={{ ph: isPh(x) }}>{x}</li>)}</ul>
        </div>
        <div class="box">
          <h2 class="label">Drawn to</h2>
          <ul>{about.interests.map((x) => <li class:list={{ ph: isPh(x) }}>{x}</li>)}</ul>
        </div>
        <div class="box">
          <h2 class="label">Heading toward</h2>
          <ol>{about.goals.map((x) => <li class:list={{ ph: isPh(x) }}>{x}</li>)}</ol>
        </div>
      </div>
    </section>

    <!-- education -->
    {education.length > 0 && (
      <section class="history" data-edit="/admin/#/collections/records/entries/education" data-edit-label="Edit education">
        <div class="section-head"><span class="label">Record</span><h2>Education</h2><span class="label">{education.length}</span></div>
        <ol class="jobs">
          {education.map((e) => (
            <li>
              <span class="mono when">{e.dates}</span>
              <span class="role"><strong>{e.institution}</strong><span>{e.program}{e.field && ` · ${e.field}`}</span></span>
              <span class="jnote">
                {e.description && <span>{e.description} </span>}
                {e.coursework.length > 0 && <span class="course">{e.coursework.join(' · ')}</span>}
                {e.achievements.length > 0 && <span class="course">{e.achievements.join(' · ')}</span>}
              </span>
            </li>
          ))}
        </ol>
      </section>
    )}

    <!-- work history and involvement -->
    <section class="history" data-edit="/admin/#/collections/records/entries/experience" data-edit-label="Edit experience">
      <div class="section-head"><span class="label">Record</span><h2>Work history</h2><span class="label">{work.length}</span></div>
      <ol class="jobs">
        {work.map((j) => (
          <li>
            <span class="mono when">{j.dates}</span>
            <span class="role"><strong>{j.role}</strong><span>{j.link ? <a href={j.link}>{j.org}</a> : j.org}</span></span>
            <span class="jnote">{j.summary}{j.highlights.length > 0 && <ul class="hl">{j.highlights.map((h) => <li>{h}</li>)}</ul>}</span>
          </li>
        ))}
      </ol>
      {involvement.length > 0 && (
        <>
          <div class="section-head inv-head"><span class="label">Now</span><h2>Teams and involvement</h2><span></span></div>
          <ul class="inv">{involvement.map((x) => <li><strong>{x.org}</strong>, {x.role.toLowerCase()} <span class="mono when">{x.dates}</span></li>)}</ul>
        </>
      )}
    </section>

    <!-- achievements -->
    {achievements.length > 0 && (
      <section class="history" data-edit="/admin/#/collections/records/entries/achievements" data-edit-label="Edit achievements">
        <div class="section-head"><span class="label">Record</span><h2>Achievements and certificates</h2><span class="label">{achievements.length}</span></div>
        <ul class="inv">
          {achievements.map((a) => (
            <li class="ach">
              <span class="mono when">{a.type}</span>
              <span>{a.link ? <a href={a.link}>{a.title}</a> : a.title}{a.issuer && <span class="iss">, {a.issuer}</span>}</span>
              <span class="mono when">{a.date}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- small facts, like notes in the margin of a drawing -->
    <section class="notes">
      <h2 class="label">Notes</h2>
      <ol>
        {about.facts.map((f) => <li class:list={{ ph: isPh(f) }}>{f}</li>)}
        <li>Unless otherwise specified, all dimensions in millimetres.</li>
      </ol>
    </section>
  </article>
</Base>

<script>
  // Hovering a balloon highlights its row in the parts list, and back.
  const link = (i: string, on: boolean) =>
    document.querySelectorAll(`[data-i="${i}"]`).forEach((el) => el.classList.toggle('hi', on));
  document.querySelectorAll<HTMLElement>('[data-i]').forEach((el) => {
    el.addEventListener('pointerenter', () => link(el.dataset.i!, true));
    el.addEventListener('pointerleave', () => link(el.dataset.i!, false));
  });
</script>

<style>
  .page-head { padding-block: clamp(32px, 6vw, 88px) clamp(24px, 4vw, 48px); display: grid; gap: 14px; }
  .serif { font-family: var(--f-text); font-style: italic; font-weight: 400; font-stretch: 100%; letter-spacing: -0.02em; color: var(--emph); }

  .spread { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: clamp(28px, 5vw, 80px); align-items: end; }
  @media (max-width: 860px) { .spread { grid-template-columns: 1fr; } }
  .portrait { margin: 0; }
  .photo { position: relative; aspect-ratio: 4 / 5; background: var(--surface); border-radius: var(--radius); box-shadow: var(--shadow); }
  .photo :global(img) { border-radius: var(--radius); }
  .photo :global(img) { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.05); transition: filter 0.6s; }
  .photo:hover :global(img) { filter: none; }
  .ph-photo { position: absolute; inset: 12px; border: var(--bw) dashed var(--rule); display: grid; place-content: center; text-align: center; gap: 6px; color: var(--graphite); font-size: 0.75rem; }
  .balloon {
    position: absolute; translate: -50% -50%;
    width: 34px; height: 34px; border-radius: 50%;
    display: grid; place-items: center;
    background: var(--paper); border: calc(var(--bw) * 1.5) solid var(--ink);
    font-family: var(--f-heading); font-weight: 700; font-size: 0.95rem;
    transition: background calc(0.2s * var(--speed)), color calc(0.2s * var(--speed)), scale calc(0.2s * var(--speed));
    cursor: default;
  }
  .balloon::after { content: ''; position: absolute; width: 5px; height: 5px; background: var(--ink); border-radius: 50%; left: 50%; top: calc(100% + 18px); translate: -50% 0; }
  .balloon::before { content: ''; position: absolute; left: 50%; top: 100%; height: 18px; border-left: var(--bw) solid var(--ink); }
  .balloon.hi { background: var(--accent); color: var(--on-accent); border-color: var(--accent); scale: calc(1 + 0.06 * var(--hover-k)); }
  figcaption { margin-top: 10px; }

  .intro { font-family: var(--f-display); font-size: calc(clamp(1.4rem, 1rem + 1.4vw, 2.1rem) * var(--h-scale)); font-weight: calc(var(--w-heading) - 100); line-height: 1.2; letter-spacing: var(--track); margin-bottom: 1.5em; }
  table { width: 100%; border-collapse: collapse; }
  caption { text-align: left; padding-bottom: 8px; }
  th { text-align: left; font-weight: 450; padding: 8px 10px 8px 0; border-top: calc(var(--bw) * 1.5) solid var(--ink); border-bottom: var(--bw) solid var(--ink); }
  td { padding: 12px 10px 12px 0; border-bottom: var(--bw) solid var(--rule); font-family: var(--f-heading); font-size: 1rem; vertical-align: top; transition: background 0.2s; }
  td:first-child { width: 3rem; }
  tr.hi td { background: color-mix(in srgb, var(--highlight) 6%, var(--paper-2)); }
  tr.hi td:first-child { color: var(--accent-ink); }

  .story { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); gap: clamp(28px, 5vw, 80px); margin-top: clamp(64px, 9vw, 130px); padding-top: 24px; border-top: var(--bw) solid var(--ink); }
  @media (max-width: 860px) { .story { grid-template-columns: 1fr; } }
  .story h2 { font-family: var(--f-mono); font-size: var(--t-mono); font-weight: 450; margin: 0 0 12px; }
  .col-a p { font-size: clamp(1.1rem, 1rem + 0.4vw, 1.3rem); line-height: 1.55; max-width: 58ch; }
  .col-a h2:not(:first-child) { margin-top: 2.5em; }
  .dropcap-p:first-of-type::first-letter { font-family: var(--f-display); font-weight: var(--w-display); font-size: 3.3em; float: left; line-height: 0.85; margin: 0.06em 0.1em 0 0; color: var(--emph); }
  .col-b { display: grid; gap: 28px; align-content: start; }
  .box ul, .box ol { margin: 0; padding: 0; list-style: none; }
  .box li { padding: 8px 0; border-bottom: var(--bw) solid var(--rule); font-family: var(--f-heading); font-size: 1rem; }
  .box ol { counter-reset: g; }
  .box ol li { counter-increment: g; display: grid; grid-template-columns: 2rem 1fr; }
  .box ol li::before { content: counter(g, decimal-leading-zero); font-family: var(--f-mono); font-size: 0.75rem; color: var(--graphite); padding-top: 3px; }
  .ph { color: var(--graphite); font-style: italic; }
  li.ph, p.ph { border-left: 2px dashed var(--accent); padding-left: 10px; }

  .history { margin-top: clamp(64px, 9vw, 120px); }
  .jobs, .inv { list-style: none; margin: 0; padding: 0; }
  .jobs li { display: grid; grid-template-columns: 11rem minmax(0, 1.2fr) minmax(0, 1.5fr); gap: 1rem; padding: 16px 0; border-bottom: var(--bw) solid var(--rule); align-items: baseline; }
  .when { color: var(--graphite); }
  .role { display: grid; gap: 2px; }
  .role strong { font-family: var(--f-heading); font-weight: 600; font-size: 1.15rem; }
  .role span { color: var(--graphite); font-size: 0.95rem; }
  .jnote { font-size: 0.98rem; line-height: 1.45; }
  @media (max-width: 760px) { .jobs li { grid-template-columns: 1fr; gap: 4px; } }
  .inv-head { margin-top: clamp(40px, 6vw, 64px); }
  .inv li { padding: 12px 0; border-bottom: var(--bw) solid var(--rule); font-family: var(--f-heading); font-size: 1.05rem; }
  .inv .when { margin-left: 8px; }
  .ach { display: grid; grid-template-columns: 8rem 1fr auto; gap: 1rem; align-items: baseline; }
  .ach .when { margin: 0; }
  .iss { color: var(--graphite); }
  @media (max-width: 640px) { .ach { grid-template-columns: 1fr; gap: 2px; } }
  .course { display: block; margin-top: 4px; color: var(--graphite); font-size: 0.9rem; }
  .hl { margin: 6px 0 0; padding-left: 1.1em; }
  .bio :global(p) { font-size: clamp(1.1rem, 1rem + 0.4vw, 1.3rem); line-height: 1.55; max-width: 58ch; }
  .bio :global(p:first-child)::first-letter { font-family: var(--f-display); font-weight: var(--w-display); font-size: 3.3em; float: left; line-height: 0.85; margin: 0.06em 0.1em 0 0; color: var(--emph); }
  .notes { margin-top: clamp(56px, 8vw, 100px); max-width: 60ch; }
  .notes h2 { font-family: var(--f-mono); font-size: var(--t-mono); font-weight: 450; margin-bottom: 10px; }
  .notes ol { margin: 0; padding-left: 1.4em; font-family: var(--f-mono); font-size: 0.82rem; line-height: 1.7; }
</style>
