---
import { getCad } from '../../lib/content';
import Base from '../../layouts/Base.astro';
import Plate from '../../components/Plate.astro';

const entries = await getCad();
const kinds = [...new Set(entries.map((e) => e.data.kind))];
// Parts that share a series are shown together under one heading, assemblies first.
const seriesNames = [...new Set(entries.map((e) => e.data.series).filter(Boolean))] as string[];
const groups = [
  ...seriesNames.map((name) => ({
    name,
    items: entries.filter((e) => e.data.series === name).sort((a, b) => Number(b.data.kind === 'Assembly') - Number(a.data.kind === 'Assembly') || a.data.number.localeCompare(b.data.number)),
  })),
  { name: seriesNames.length ? 'Other models' : '', items: entries.filter((e) => !e.data.series) },
].filter((g) => g.items.length);
---
<Base title="CAD library" sheet="02 · CAD library" description="CAD parts, assemblies and mechanisms by Muhammad Ali, viewable in 3D.">
  <section class="wrap">
    <header class="page-head" data-edit="/admin/#/collections/cad/new" data-edit-label="Add CAD entry">
      <span class="label">02 / CAD</span>
      <h1>CAD library</h1>
      <p>Parts, assemblies and mechanisms, including ones that never became a full project. Entries marked 3D can be rotated in the browser.</p>
    </header>

    {kinds.length > 1 && (
      <div class="kinds label">
        {kinds.map((k) => <span>{k} · {entries.filter((e) => e.data.kind === k).length}</span>)}
      </div>
    )}

    {groups.map((g, gi) => (
      <section class="group">
        {g.name && <div class="section-head"><span class="label">{g.items.length} {g.items.length === 1 ? 'model' : 'models'}</span><h2>{g.name}</h2><span></span></div>}
        <ul class="drawer">
          {g.items.map((e) => (
            <li>
              <a href={`/cad/${e.id}/`}>
                <Plate src={e.data.images[0]?.src} alt={e.data.images[0]?.alt} number={e.data.number} ratio="3 / 2" sizes="(max-width: 700px) 100vw, 33vw" />
                <div class="meta">
                  <span class="mono">{e.data.number}</span>
                  <span class="mono kind">{e.data.kind}</span>
                  {e.data.model && <span class="badge mono">3D</span>}
                </div>
                <h2>{e.data.title}{e.data.sample && <span class="sample-tag">Sample</span>}</h2>
                <p>{e.data.summary}</p>
              </a>
            </li>
          ))}
          {gi === groups.length - 1 && (
            <li class="slot" aria-hidden="true">
              <div class="slot-box"><span class="mono">C-{String(entries.length + 1).padStart(3, '0')}</span><span class="label">Next model goes here</span></div>
            </li>
          )}
        </ul>
      </section>
    ))}
  </section>
</Base>

<style>
  .page-head { padding-block: clamp(32px, 6vw, 88px) clamp(24px, 4vw, 48px); display: grid; gap: 14px; }
  .page-head p { color: var(--graphite); max-width: 52ch; margin: 0; }
  .kinds { display: flex; gap: 1.5rem; flex-wrap: wrap; padding-bottom: 14px; }
  .group + .group { margin-top: clamp(40px, 6vw, 72px); }
  .group .section-head { margin-bottom: 0; }
  .drawer {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    border-top: var(--bw) solid var(--ink); border-left: var(--bw) solid var(--rule);
  }
  .drawer > li { border-right: var(--bw) solid var(--rule); border-bottom: var(--bw) solid var(--rule); }
  .drawer a { display: grid; gap: 10px; padding: 14px 14px 20px; text-decoration: none; height: 100%; align-content: start; }
  .drawer a:hover { color: inherit; background: color-mix(in srgb, var(--highlight) 5%, var(--paper-2)); }
  .drawer a:hover :global(.plate img) { transform: scale(calc(1 + 0.04 * var(--hover-k))) rotate(calc(-0.5deg * var(--hover-k))); }
  .meta { display: flex; gap: 10px; align-items: center; color: var(--graphite); font-size: 0.72rem; }
  .badge { margin-left: auto; color: var(--accent-ink); border: var(--bw) solid currentColor; border-radius: var(--radius-btn); padding: 1px 6px; }
  h2 { font-size: 1.25rem; font-stretch: 100%; display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
  .drawer p { color: var(--graphite); font-size: 0.95rem; line-height: 1.45; margin: 0; }
  .slot { padding: 14px; }
  .slot-box { aspect-ratio: 1; border: var(--bw) dashed var(--rule); display: grid; place-content: center; text-align: center; gap: 6px; color: var(--graphite); }
</style>
