{
  "version": 1,
  "preset": "helk",
  "scheme": "dark",
  "colors": {
    "bg": "#dceeed",
    "bg2": "#c0e0de",
    "surface": "#c0e0de",
    "text": "#122c34",
    "text2": "#506d75",
    "border": "#a1c0bf",
    "primary": "#143642",
    "secondary": "#5a3a31",
    "tertiary": "#506d75",
    "accent": "#5a3a31",
    "highlight": "#ffc857"
  },
  "darkColors": {
    "bg": "#122c34",
    "bg2": "#143642",
