  "three": {
    "autoRotate": false,
    "rotateSpeed": 20,
    "exposure": 0.7,
    "shadow": 1,
    "shadowSoftness": 0.8,
    "environment": "neutral",
    "material": "original",
    "zoom": 100,
    "sensitivity": 1,
    "backdrop": "grid"
