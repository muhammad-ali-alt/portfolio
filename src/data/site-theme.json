    "angle": 160,
    "stops": [
      {
        "color": "#143642",
        "pos": 0
      },
      {
        "color": "#dceeed",
        "pos": 100
      }
    ],
    "intensity": 10,
    "targets": {
      "page": false,
      "hero": false,
      "cards": false,
      "accents": false,
      "buttons": false
    }
  },
  "motion": {
    "enabled": true,
    "style": "none",
    "direction": "up",
    "distance": 16,
    "duration": 500,
    "easing": "smooth",
    "stagger": 60,
    "scrollReveal": false,
    "hover": "subtle",
    "pageTransition": "fade",
    "parallax": 0,
    "smoothScroll": true
