    "text2": "#8caaab",
    "border": "#385459",
    "primary": "#ffc857",
    "secondary": "#c0e0de",
    "tertiary": "#8caaab",
    "accent": "#ffc857",
    "highlight": "#ffc857"
  },
  "type": {
    "display": "archivo",
    "heading": "archivo",
    "body": "sourceSerif",
    "ui": "jetbrainsMono",
    "baseScale": 1,
    "headingScale": 1,
    "displayWeight": 750,
    "headingWeight": 650,
    "bodyWeight": 400,
    "lineHeight": 1.55,
    "headingTracking": -0.02,
    "displayWidth": 118,
    "measure": 68
